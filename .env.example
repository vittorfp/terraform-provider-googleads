# Copy to .env, fill in values, then load with:
#   set -a; source .env; set +a
# .env is gitignored.
#
# Optional request headers:
#
# Set LOGIN_CUSTOMER_ID only when accessing target accounts through a manager
# account. Developer tokens were sunset on 2026-09-09; keep the legacy setting
# only while using an API version or project migration that still needs it.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_DEVELOPER_TOKEN=

# ── Auth mode A: Service account (recommended for CI / server-to-server) ──
#
# Service-account JSON key file + the Workspace user the SA impersonates.
# Requires Workspace domain-wide delegation to be configured for the
# service account with the adwords scope. The impersonated user must have
# access to the target Ads accounts.
#
# When both of these are set, this mode wins over refresh-token + ADC.
# GOOGLE_ADS_SERVICE_ACCOUNT_JSON_PATH=/path/to/sa.json
# GOOGLE_ADS_IMPERSONATE_EMAIL=user@example.com

# ── Auth mode B: Refresh token (recommended for local development) ────────
#
# OAuth client for the *googleads-tfgen* tool. Create once in Google Cloud
# Console → APIs & Services → Credentials → Create OAuth client ID → Desktop
# app. These don't change; you set them once and forget.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Optional: skip the cached browser flow and use a pre-existing refresh
# token (useful for CI). When this is set, googleads-tfgen does not open a
# browser.
# GOOGLE_ADS_REFRESH_TOKEN=

# ── Auth mode C: ADC (gcloud auth application-default login --scopes=...) ─
# No env vars needed. Falls through automatically when neither A nor B is
# fully configured.

# Optional: sandbox customer ID for `make testacc`.
# GOOGLE_ADS_TEST_CUSTOMER_ID=
